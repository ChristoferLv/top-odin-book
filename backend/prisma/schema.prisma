generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum PostType {
  POST
  REPLY
  SHARE
  SHARE_REPLY
}

enum NotificationType {
  LIKE
  REPLY
  SHARE
  FOLLOW
}

model Users {
  id         Int         @id @default(autoincrement())
  name       String
  username   String      @unique @db.VarChar(30)
  bio        String?
  password   String
  picture    Bytes?
  mime       String?
  background Bytes?
  bgmime     String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  posts      Posts[]
  comments   Comments[]
  likes      Likes[]
  followedBy Follows[]   @relation("followedBy")
  following  Follows[]   @relation("following")
  bookmarks  Bookmarks[]
  midias     Midias[]

  notificationsAuthor   Notifications[] @relation("notificationsAuthor")
  notificationsReceived Notifications[] @relation("notificationsReceived")
}

model Posts {
  id        Int      @id @default(autoincrement())
  postType  PostType @default(POST)
  content   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  authorId  Int
  author    Users    @relation(fields: [authorId], references: [id])

  replyPost      Posts[] @relation("originlPostReference")
  originalPostId Int?
  originalPost   Posts?  @relation("originlPostReference", fields: [originalPostId], references: [id])

  comments  Comments[]
  likes     Likes[]
  bookmarks Bookmarks[]

  hasMidia Boolean? @default(false)
  midia    Midias?

  notifications Notifications[]

  @@unique([originalPostId, authorId, postType], where: raw("\"postType\" IN ('SHARE')"))
}

model Comments {
  id        Int      @id @default(autoincrement())
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  postId    Int
  authorId  Int
  post      Posts    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Users    @relation(fields: [authorId], references: [id])
}

model Likes {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  postId     Int
  post       Posts    @relation(fields: [postId], references: [id], onDelete: Cascade)
  whoLikedId Int
  whoLiked   Users    @relation(fields: [whoLikedId], references: [id])

  @@unique([postId, whoLikedId])
}

model Bookmarks {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  postId          Int
  post            Posts    @relation(fields: [postId], references: [id])
  whoBookmarkedId Int
  whoBookmarked   Users    @relation(fields: [whoBookmarkedId], references: [id])

  @@unique([postId, whoBookmarkedId])
}

model Follows {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  followedById Int
  followedBy   Users    @relation("followedBy", fields: [followedById], references: [id])
  followingId  Int
  following    Users    @relation("following", fields: [followingId], references: [id])

  @@unique([followingId, followedById])
}

model Midias {
  id      Int    @id @default(autoincrement())
  content Bytes
  mime    String
  ownerId Int
  owner   Users  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postId  Int    @unique
  post    Posts  @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Notifications {
  id         Int              @id @default(autoincrement())
  type       NotificationType
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  readAt     DateTime?        @db.Timestamptz(6)
  receiverId Int
  receiver   Users            @relation("notificationsReceived", fields: [receiverId], references: [id])
  authorId   Int
  author     Users            @relation("notificationsAuthor", fields: [authorId], references: [id])
  postId     Int?
  post       Posts?           @relation(fields: [postId], references: [id])
}
