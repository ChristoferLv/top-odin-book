generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id         Int      @id @default(autoincrement())
  username   String   @unique @db.VarChar(30)
  password   String
  picture    Bytes?
  mime       String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

